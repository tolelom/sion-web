{
  "name": "sion-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:types": "node scripts/contract-types.mjs",
    "contract:check": "node scripts/contract-types.mjs --check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.20.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.4",
    "vitest": "^5.0.5"
